---
import Layout from "../layouts/Layout.astro";
import { LoginCard } from "../components/LoginCard";
import { Meteors } from "../components/ui/Meteors";
---

<Layout title="Login | CANSAT">
  <main class="min-h-screen w-full flex flex-col relative overflow-x-hidden bg-[#07070a]">
    {/* Back to Home Button */}
    <a
      href="/"
      class="absolute top-4 left-4 sm:top-8 sm:left-8 z-20 inline-flex items-center justify-center whitespace-nowrap rounded-lg text-xs sm:text-sm font-medium transition-all border border-white/20 bg-black/60 hover:bg-white/10 hover:border-white/40 text-white h-8 sm:h-10 px-3 sm:px-4 py-2 font-title uppercase tracking-widest backdrop-blur-md cursor-pointer shadow-lg active:scale-95"
    >
      <svg
        class="mr-1.5 sm:mr-2 h-3.5 w-3.5 sm:h-4 sm:w-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
      >
      Volver
    </a>

    {/* Meteors Background Effect */}
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <Meteors client:load number={40} />
    </div>

    {/* Two Column Layout */}
    <div
      class="w-full min-h-screen flex flex-col md:flex-row z-10 relative items-center justify-center"
    >
      {/* Left side: Astronaut Image */}
      <div
        class="hidden md:flex flex-1 items-center justify-center p-6 md:p-10 h-full"
      >
        <img
          src="/astronauta.webp"
          alt="Astronauta"
          class="max-h-[80vh] w-auto object-contain drop-shadow-2xl scale-x-[-1]"
          style="animation: float 6s ease-in-out infinite;"
        />
      </div>

      {/* Right side: Login Card */}
      <div
        class="w-full md:w-[480px] lg:w-[520px] flex-shrink-0 flex items-center justify-center px-4 sm:px-8 md:pr-16 lg:pr-24 pt-20 pb-10 md:py-8"
      >
        <LoginCard client:load />
      </div>
    </div>
  </main>
</Layout>
