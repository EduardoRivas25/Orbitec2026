---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
}

const defaultDescription =
	"ORBITEC es el equipo multidisciplinario del ITSU dedicado a la ingeniería aeroespacial y el desarrollo del micro satélite CanSat 2026 NightRaptor.";
const defaultImage = "/logo%20cansat2026-final1_sbg.webp";

const {
	title = "Orbitec",
	description = defaultDescription,
	image = defaultImage,
	canonicalUrl = Astro.url
		? Astro.url.href
		: "https://orbitec-cansat2026.com",
} = Astro.props;

const schemaData = {
	"@context": "https://schema.org",
	"@type": "EducationalOrganization",
	name: "ORBITEC",
	alternateName: "ORBITEC CanSat 2026",
	url: canonicalUrl,
	logo: defaultImage,
	description: description,
	parentOrganization: {
		"@type": "EducationalOrganization",
		name: "Instituto Tecnológico Superior de Uruapan (ITSU)",
	},
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Principal -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="ORBITEC, CanSat 2026, ITSU, NightRaptor, tecnología espacial, satélite educativo, ingeniería aeroespacial, telemetría"
		/>
		<meta name="author" content="ORBITEC - ITSU" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#000004" />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph / Facebook -->
		<meta property="og:site_name" content="ORBITEC CanSat 2026" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:locale" content="es_MX" />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Favicons -->
		<link
			rel="icon"
			type="image/webp"
			href="/logo%20cansat2026-final1_sbg.webp"
		/>
		<link rel="shortcut icon" href="/logo%20cansat2026-final1_sbg.webp" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap"
			rel="stylesheet"
		/>

		<!-- Structured Data (JSON-LD) -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify(schemaData)}
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
