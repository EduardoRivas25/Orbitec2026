---
---

<section class="relative w-full py-16 md:py-24 overflow-hidden bg-[#000004]">
  <div class="max-w-5xl mx-auto px-6 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
      
      <!-- Imagen -->
      <div class="w-full lg:w-1/2 flex justify-center order-1 lg:order-2">
        <div class="relative w-full max-w-xs lg:max-w-md hover:scale-105 transition-transform duration-700 ease-out flex items-center justify-center">
           <!-- Background Glow detrás de la imagen -->
           <div class="absolute top-1/2 left-[65%] -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-azul-light/30 rounded-full blur-[45px] -z-10 pointer-events-none"></div>
           
           <img 
             src="/logo cansat2026-final1_sbg.webp" 
             alt="Logo CanSat 2026" 
             class="relative z-10 w-full h-auto object-contain"
           />
        </div>
      </div>

      <!-- Texto descriptivo -->
      <div class="w-full lg:w-1/2 text-left order-2 lg:order-1 lg:-translate-x-8">
        <h2 class="font-title text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 uppercase tracking-tighter leading-none">
          ¿Qué es <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-azul-light to-rojo-light">ORBITEC?</span>
        </h2>
        
        <div class="space-y-4 text-gray-300 text-base md:text-lg font-light leading-relaxed">
          <p>
            Equipo multidisciplinario del <strong class="text-white font-medium">ITSU</strong> dedicado al desarrollo de tecnología espacial mediante la plataforma <strong class="text-white font-medium">CanSat</strong>.
          </p>
          <p>
            Buscamos acercar la ingeniería aeroespacial a los estudiantes y desarrollar proyectos con impacto positivo.
          </p>
        </div>

        <div class="mt-8">
          <a href="#nightraptor" class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-full text-white font-title uppercase tracking-[0.15em] text-xs md:text-sm transition-all hover:border-azul-light/50 hover:shadow-[0_0_15px_rgba(1,95,179,0.2)] group">
            Conoce la misión
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
