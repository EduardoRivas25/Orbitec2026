---
const team = [
  { name: "Eduardo", role: "Software", portrait: 0, linkedin: "https://www.linkedin.com/in/juan-eduardo-rojas-rivas-8ab109386" },
  { name: "Jaime", role: "Estructuras", portrait: 2, linkedin: null as string | null },
  { name: "David", role: "Electrónica", portrait: 4, linkedin: null as string | null },
  { name: "Aldo", role: "Electrónica", portrait: 1, linkedin: null as string | null },
  { name: "Ariadna", role: "Estructuras", portrait: 3, linkedin: null as string | null },
];
---

<section id="equipo" aria-labelledby="team-title" class="relative w-full overflow-hidden bg-[#000004] py-20 lg:py-28">
  <div class="pointer-events-none absolute left-1/2 top-1/3 h-80 w-80 -translate-x-1/2 rounded-full bg-azul-light/10 blur-[110px]"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-6">
    <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.3em] text-azul-light">Personas detrás de la misión</p>
      <h2 id="team-title" class="font-title text-4xl font-bold uppercase tracking-tighter text-white md:text-5xl lg:text-6xl">
        Nuestro <span class="bg-gradient-to-r from-azul-light to-rojo-light bg-clip-text text-transparent">equipo</span>
      </h2>
      <p class="mt-5 text-sm leading-relaxed text-gray-300 md:text-base">
        Cinco disciplinas y perspectivas trabajando juntas para llevar PATSARHI-1 del diseño al vuelo.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-1 sm:grid-cols-3 lg:grid-cols-5">
      {team.map((member) => (
        <article class="group relative isolate overflow-hidden bg-[#0B1120]">
          <div class="relative overflow-hidden bg-[#050816]">
            <img
              src="/team-avatars-fictional.png"
              alt={`Retrato ficticio ilustrativo de ${member.name}`}
              width="2172"
              height="724"
              loading="lazy"
              class="block h-auto max-w-none transition-transform duration-700 ease-out group-hover:scale-105"
              style={`width: 500%; margin-left: -${member.portrait * 100}%;`}
            />
          </div>
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#000004] via-[#000004]/10 to-transparent"></div>
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 p-3 sm:p-4">
            <h3 class="font-title text-lg font-bold leading-tight text-white sm:text-xl">{member.name}</h3>
            <p class="mt-1 font-mono text-[10px] font-bold uppercase leading-tight tracking-wide text-amber-400 sm:text-xs">{member.role}</p>
          </div>
          {member.linkedin && (
            <a
              href={member.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver el perfil de LinkedIn de ${member.name}`}
              class="absolute inset-0 z-20 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-azul-light"
            >
              <span class="absolute right-3 top-3 flex h-9 w-9 -translate-y-2 items-center justify-center rounded-full bg-[#0A66C2] text-white opacity-0 shadow-lg transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.266 2.37 4.266 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>
              </span>
            </a>
          )}
        </article>
      ))}
    </div>
    <p class="mt-7 text-center font-mono text-xs text-gray-500">Retratos ficticios de referencia; se sustituirán por fotografías del equipo.</p>
  </div>
</section>
