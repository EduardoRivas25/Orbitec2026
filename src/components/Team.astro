---
import JaimePhoto from "../assets/team/Jaime.webp";
import EduardoPhoto from "../assets/team/Eduardo.webp";
import DavidPhoto from "../assets/team/David.webp";
import AriadnaPhoto from "../assets/team/Ariadna.webp";
import AldoPhoto from "../assets/team/Aldo.webp";

const team = [
  { name: "Eduardo", role: "Líder de Proyecto", photo: EduardoPhoto, linkedin: "https://www.linkedin.com/in/juan-eduardo-rojas-rivas-8ab109386" },
  { name: "Jaime", role: "Estructuras", photo: JaimePhoto, linkedin: null },
  { name: "David", role: "Electrónica", photo: DavidPhoto, linkedin: null },
  { name: "Aldo", role: "Electrónica", photo: AldoPhoto, linkedin: null },
  { name: "Ariadna", role: "Estructuras", photo: AriadnaPhoto, linkedin: null },
];
---

<section id="equipo" aria-labelledby="team-title" class="relative w-full overflow-hidden bg-[#000004] py-20 lg:py-28">
  <div class="relative z-10 mx-auto max-w-[1500px] px-6">
    <div class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.3em] text-azul-light">Personas detrás de la misión</p>
      <h2 id="team-title" class="font-title text-4xl font-bold uppercase tracking-tighter text-white md:text-5xl lg:text-6xl">
        Nuestro <span class="bg-gradient-to-r from-azul-light to-rojo-light bg-clip-text text-transparent">equipo</span>
      </h2>
      <p class="mt-5 text-sm leading-relaxed text-gray-300 md:text-base">
        Cinco disciplinas y perspectivas trabajando juntas para llevar PATSARHI-1 del diseño al vuelo.
      </p>
    </div>

    <div id="team-grid" class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
      {team.map((member) => (
        <button
          type="button"
          class="team-card group relative isolate overflow-hidden bg-transparent p-3 text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-azul-light"
          data-team-card
          data-name={member.name}
          data-role={member.role}
          data-photo={member.photo.src}
          data-linkedin={member.linkedin ?? ""}
          aria-label={`Ver a ${member.name}, ${member.role}`}
        >
          <span class="team-card-photo-frame relative block aspect-[3/4] overflow-hidden bg-transparent">
            <img
              src={member.photo.src}
              alt={`Fotografía de ${member.name}`}
              width={member.photo.width}
              height={member.photo.height}
              loading="lazy"
              class="team-card-photo h-full w-full object-cover object-center"
            />
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#000004] via-[#000004]/10 to-transparent"></span>
            <span class="pointer-events-none absolute inset-x-0 bottom-0 p-4 sm:p-5">
              <span class="block font-title text-xl font-bold leading-tight text-white sm:text-2xl">{member.name}</span>
              <span class="mt-1.5 block font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-[#ff7580] sm:text-xs">{member.role}</span>
            </span>
            <span aria-hidden="true" class="pointer-events-none absolute right-3 top-3 rounded-full border border-white/20 bg-black/40 px-2.5 py-1 font-mono text-[9px] uppercase tracking-widest text-white/80 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">Ver perfil</span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <dialog
    id="team-profile"
    class="fixed inset-0 m-0 h-dvh w-screen max-h-none max-w-none items-center justify-center overflow-y-auto border-0 bg-transparent px-5 py-10 text-white"
    aria-labelledby="team-profile-name"
    aria-describedby="team-profile-role"
  >
    <button type="button" data-team-close class="absolute right-5 top-5 z-10 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-white/5 text-2xl leading-none text-white transition-colors hover:border-[#69b7ff]/70 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-azul-light" aria-label="Cerrar perfil">×</button>
    <div class="team-profile-content relative mx-auto flex min-h-full w-full max-w-xl flex-col items-center justify-center text-center">
      <img id="team-profile-photo" src="" alt="" class="team-profile-photo h-[min(72vh,680px)] w-auto max-w-[min(92vw,520px)] rounded-sm object-contain" />
      <div class="mt-2">
        <p class="mb-1 font-mono text-[10px] uppercase tracking-[0.35em] text-[#69b7ff]">Equipo ORBITEC · CanSat 2026</p>
        <h3 id="team-profile-name" class="font-title text-4xl font-bold uppercase tracking-tight text-white sm:text-5xl md:text-6xl"></h3>
        <p id="team-profile-role" class="mt-3 font-mono text-sm font-bold uppercase tracking-[0.24em] text-[#e55360] sm:text-base"></p>
        <a id="team-profile-linkedin" class="mt-6 hidden items-center gap-2 rounded-sm border border-white/15 px-4 py-2 font-mono text-xs uppercase tracking-widest text-white/80 transition-colors hover:border-[#69b7ff]/60 hover:text-white" target="_blank" rel="noopener noreferrer">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </dialog>
</section>

<script>
  const cards = [...document.querySelectorAll<HTMLButtonElement>("[data-team-card]")];
  const profile = document.querySelector<HTMLDialogElement>("#team-profile");
  const profilePhoto = document.querySelector<HTMLImageElement>("#team-profile-photo");
  const profileName = document.querySelector<HTMLElement>("#team-profile-name");
  const profileRole = document.querySelector<HTMLElement>("#team-profile-role");
  const profileLinkedIn = document.querySelector<HTMLAnchorElement>("#team-profile-linkedin");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-team-close]");
  let activeCard: HTMLButtonElement | null = null;

  if (profile && profilePhoto && profileName && profileRole && profileLinkedIn && closeButton) {
    const closeProfile = () => {
      if (!activeCard) return;
      profile.close();
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        activeCard = card;
        const name = card.dataset.name ?? "";
        const role = card.dataset.role ?? "";
        const photo = card.dataset.photo ?? "";
        const linkedin = card.dataset.linkedin ?? "";

        profileName.textContent = name;
        profileRole.textContent = `Encargado de ${role}`;
        profilePhoto.src = photo;
        profilePhoto.alt = `Fotografía de ${name}`;
        profileLinkedIn.href = linkedin;
        profileLinkedIn.classList.toggle("hidden", !linkedin);
        profileLinkedIn.classList.toggle("inline-flex", Boolean(linkedin));

        profile.showModal();
        document.body.style.overflow = "hidden";
        closeButton.focus({ preventScroll: true });
      });
    });

    closeButton.addEventListener("click", closeProfile);
    profile.addEventListener("click", (event) => {
      if (event.target === profile) closeProfile();
    });
    profile.addEventListener("close", () => {
      document.body.style.overflow = "";
      activeCard?.focus({ preventScroll: true });
      activeCard = null;
    });
  }
</script>

<style>
  #team-profile[open] {
    position: fixed;
    inset: 0;
    display: grid;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 2rem;
    box-sizing: border-box;
    place-items: center;
    animation: profile-backdrop-in 220ms ease-out both;
  }

  #team-profile::backdrop {
    background: rgb(0 0 4 / 72%);
  }

  .team-profile-content {
    width: min(100%, 36rem);
    min-height: 100%;
    margin-inline: auto;
    animation: profile-content-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .team-card-photo {
    -webkit-mask-image: radial-gradient(ellipse 90% 96% at 50% 42%, #000 72%, transparent 100%);
    mask-image: radial-gradient(ellipse 90% 96% at 50% 42%, #000 72%, transparent 100%);
    transform: scale(1);
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .team-card:hover .team-card-photo,
  .team-card:focus-visible .team-card-photo {
    transform: scale(1.08);
  }

  .team-card-photo-frame {
    contain: paint;
    clip-path: inset(0);
  }

  .team-profile-photo {
    max-height: 72vh;
  }

  @media (prefers-reduced-motion: reduce) {
    #team-profile[open],
    .team-profile-content {
      animation-duration: 1ms;
    }
  }

  @keyframes profile-backdrop-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes profile-content-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.76);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
