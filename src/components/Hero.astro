---
import innotvaTecNMLogo from '../assets/innotvatecnm2026.png';
import ShiftingCountdown from './ui/countdown-timer';
import { RevealText } from './ui/reveal-text';
---

<section
  class="relative min-h-[100dvh] min-h-screen w-full flex items-center justify-center overflow-hidden"
>
  <!-- Video Background -->
  <div class="absolute inset-0 w-full h-full z-0">
    <video
      id="hero-video"
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      preload="auto"
      class="w-full h-full object-cover scale-105"
    >
      <source src="/hero-video.webm" type="video/webm" />
      <source src="/hero-video.mp4" type="video/mp4" />
    </video>
    <!-- Overlay gradiente oscuro en la parte inferior para fusionarse con el fondo global -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#000004]/70 via-[#000004]/50 to-[#000004] z-10"
    >
    </div>
  </div>

  <!-- Hero Content -->
  <div
    class="relative z-20 text-center px-4 w-full max-w-5xl mx-auto flex flex-col items-center pt-24 pb-12 sm:pt-28 sm:pb-16"
  >
    <span
      class="font-title mb-3 sm:mb-4 max-w-[20rem] sm:max-w-none text-[11px] sm:text-xs md:text-sm font-bold tracking-[0.14em] sm:tracking-[0.2em] text-gray-300 uppercase text-balance"
      >Sistemas Aeroespaciales Tipo: Cansat</span
    >

    <h1
      aria-label="PATSARHI-1"
      class="font-title mb-3 sm:mb-6 font-bold tracking-tighter text-white drop-shadow-2xl uppercase w-full flex justify-center max-w-full overflow-hidden sm:overflow-visible"
    >
      <RevealText
        text="PATSARHI-1"
        textColor="text-white"
        fontSize="text-[clamp(24px,8vw,124px)]"
        letterDelay={0.08}
        overlayDelay={0.15}
        overlayDuration={2.8}
        springDuration={600}
        client:load
      />
    </h1>

    <div class="mb-4 sm:mb-6 flex flex-col items-center gap-2 sm:gap-3">
      <img
        src={innotvaTecNMLogo.src}
        alt="InnovaTecNM 2026"
        class="h-16 w-auto max-w-[min(70vw,18rem)] object-contain drop-shadow-[0_0_24px_rgba(255,255,255,0.22)] sm:h-28 md:h-32"
      />
      <span class="rounded-full border border-white/20 bg-black/45 px-4 py-1 sm:px-6 sm:py-2 font-title text-[11px] sm:text-sm font-bold uppercase tracking-[0.16em] sm:tracking-[0.22em] text-white shadow-[0_0_24px_rgba(0,0,0,0.35)] backdrop-blur-sm">
        Etapa Nacional · 2026
      </span>
    </div>
    <ShiftingCountdown client:load />
  </div>
</section>

<script>
  const heroVideo = document.querySelector<HTMLVideoElement>('#hero-video');

  heroVideo?.addEventListener('ended', () => {
    heroVideo.currentTime = 0;
    void heroVideo.play();
  });
</script>
