---
---
<section class="relative h-screen w-full flex items-center justify-center overflow-hidden">
  <!-- Video Background -->
  <div class="absolute inset-0 w-full h-full z-0">
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      class="w-full h-full object-cover scale-105"
    >
      <source src="/herovideo.webm" type="video/webm" />
    </video>
    <!-- Overlay gradiente oscuro en la parte inferior para fusionarse con el fondo global -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#000004]/60 via-[#000004]/40 to-[#000004] z-10"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-20 text-center px-4 max-w-5xl mx-auto flex flex-col items-center mt-20">
    <span class="text-gray-400 tracking-[0.3em] uppercase text-sm mb-4 font-bold">Proyecto Aeroespacial</span>
    
    <h1 class="text-6xl md:text-8xl lg:text-9xl font-title font-bold text-white mb-6 tracking-tighter drop-shadow-2xl uppercase">
      CANSAT <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-azul-light to-rojo-light">2026</span>
    </h1>
    
    <p class="text-lg md:text-2xl text-gray-300 mb-10 max-w-2xl font-light leading-relaxed">
      Misión espacial estudiantil. Explorando los límites de la tecnología y la innovación.
    </p>
    
    <a href="#descubrir" class="group relative px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-md text-white rounded-full transition-all duration-300 overflow-hidden flex items-center gap-3">
      <span class="relative z-10 font-title tracking-widest uppercase text-sm font-bold">Descubrir Más</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 relative z-10 group-hover:translate-y-1 transition-transform">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </a>
  </div>
</section>
