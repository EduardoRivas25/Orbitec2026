---
import innotvaTecNMLogo from '../assets/innotvatecnm2026.png';
import ShiftingCountdown from './ui/countdown-timer';
---

<section
  class="relative h-screen w-full flex items-center justify-center overflow-hidden"
>
  <!-- Video Background -->
  <div class="absolute inset-0 w-full h-full z-0">
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover scale-105"
    >
      <source src="/hero-video.webm" type="video/webm" />
      <source src="/hero-video.mp4" type="video/mp4" />
    </video>
    <!-- Overlay gradiente oscuro en la parte inferior para fusionarse con el fondo global -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#000004]/60 via-[#000004]/40 to-[#000004] z-10"
    >
    </div>
  </div>

  <!-- Hero Content -->
  <div
    class="relative z-20 text-center px-4 max-w-5xl mx-auto flex flex-col items-center pt-20 pb-8 sm:pt-24"
  >
    <span
      class="font-title text-gray-400 tracking-[0.3em] uppercase text-sm mb-4 font-bold"
      >Proyecto Aeroespacial</span
    >

    <h1
      class="text-5xl sm:text-6xl md:text-8xl lg:text-9xl font-title font-bold text-white mb-4 sm:mb-6 tracking-tighter drop-shadow-2xl uppercase"
    >
      CANSAT <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-white via-azul-light to-rojo-light"
        >2026</span
      >
    </h1>

    <p
      class="font-title text-base sm:text-lg md:text-2xl text-gray-300 mb-6 sm:mb-8 max-w-2xl font-light leading-relaxed"
    >
      Misión espacial estudiantil. Explorando los límites de la tecnología y la
      innovación.
    </p>

    <div class="mb-4 sm:mb-5 flex flex-col items-center gap-2 sm:gap-3">
      <img
        src={innotvaTecNMLogo.src}
        alt="InnovaTecNM 2026"
        class="h-20 w-auto max-w-[min(75vw,22rem)] object-contain drop-shadow-[0_0_24px_rgba(255,255,255,0.22)] sm:h-28 md:h-32"
      />
      <span class="rounded-full border border-white/20 bg-black/45 px-5 py-1.5 font-title text-xs sm:px-6 sm:py-2 sm:text-sm font-bold uppercase tracking-[0.22em] text-white shadow-[0_0_24px_rgba(0,0,0,0.35)] backdrop-blur-sm">
        Etapa Nacional · 2026
      </span>
    </div>
    <ShiftingCountdown client:load />
  </div>
</section>
