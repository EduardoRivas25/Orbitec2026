---

---

<section
  id="telemetria"
  class="relative w-full pt-16 pb-10 lg:py-16 bg-[#000004] overflow-hidden"
>
  <div
    class="max-w-5xl mx-auto px-6 relative z-10 flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-16"
  >
    <!-- Lado Izquierdo: Imágenes interactivas -->
    <div
      class="w-full lg:w-1/2 flex justify-center items-center relative order-1 lg:order-1 h-[280px] md:h-[450px]"
    >
      <!-- Contenedor Interactivo -->
      <div
        class="relative w-full h-full flex justify-center items-center"
        id="telemetry-gallery"
      >
        <!-- Glow dinámico -->
        <div
          id="telemetry-glow"
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 sm:w-64 sm:h-64 bg-transparent rounded-full blur-[80px] pointer-events-none -z-10 transition-colors duration-700"
        >
        </div>

        <!-- GPS Image -->
        <img
          id="img-gps"
          src="/gpsneo6mv2.png"
          alt="Módulo GPS NEO-6M v2"
          class="absolute cursor-pointer object-contain transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] z-10 top-1/2 -translate-y-1/2 h-[150px] md:h-[260px] w-auto drop-shadow-lg opacity-100 scale-100 left-[30%] md:left-[15%] -translate-x-1/2"
        />

        <!-- LoRa Image -->
        <img
          id="img-lora"
          src="/lorasx.png"
          alt="Módulo LoRa SX1278"
          class="absolute cursor-pointer object-contain transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] z-10 top-1/2 -translate-y-1/2 h-[150px] md:h-[260px] w-auto drop-shadow-lg opacity-100 scale-100 left-[70%] md:left-[85%] -translate-x-1/2"
        />
      </div>
    </div>

    <!-- Lado Derecho: Contenido Fijo -->
    <div
      class="w-full lg:w-1/2 flex flex-col justify-center text-center lg:text-left order-2 lg:order-2"
    >
      <h2
        class="font-title text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 uppercase tracking-tighter leading-none"
      >
        Telemetría <br />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-azul-light to-rojo-light"
        >
          Transmisión y Localización</span
        >
      </h2>

      <p
        class="text-gray-300 font-light text-sm md:text-base mb-6 leading-relaxed max-w-xl mx-auto lg:mx-0"
      >
        Para asegurar una comunicación ininterrumpida y conocer la posición
        exacta del CanSat en todo momento, empleamos módulos de largo alcance y
        posicionamiento satelital.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-4 mt-2">
        <!-- GPS Info -->
        <div>
          <h3
            class="text-lg md:text-xl font-bold text-white mb-2 font-mono text-left"
          >
            GPS NEO-6M v2
          </h3>
          <ul class="text-left text-gray-400 space-y-2 text-xs md:text-sm">
            <li class="flex items-start gap-2">
              <div
                class="w-1.5 h-1.5 rounded-full bg-azul-light mt-1.5 flex-shrink-0"
              >
              </div>
              <span>Posicionamiento global de alta precisión.</span>
            </li>
            <li class="flex items-start gap-2">
              <div
                class="w-1.5 h-1.5 rounded-full bg-azul-light mt-1.5 flex-shrink-0"
              >
              </div>
              <span>Proporciona latitud, longitud y altitud.</span>
            </li>
            <li class="flex items-start gap-2">
              <div
                class="w-1.5 h-1.5 rounded-full bg-azul-light mt-1.5 flex-shrink-0"
              >
              </div>
              <span>Antena cerámica para mejor recepción.</span>
            </li>
          </ul>
        </div>

        <!-- LoRa Info -->
        <div>
          <h3
            class="text-lg md:text-xl font-bold text-white mb-2 font-mono text-left"
          >
            LoRa SX1278
          </h3>
          <ul class="text-left text-gray-400 space-y-2 text-xs md:text-sm">
            <li class="flex items-start gap-2">
              <div
                class="w-1.5 h-1.5 rounded-full bg-rojo-light mt-1.5 flex-shrink-0"
              >
              </div>
              <span>Transmisión de muy largo alcance (km).</span>
            </li>
            <li class="flex items-start gap-2">
              <div
                class="w-1.5 h-1.5 rounded-full bg-rojo-light mt-1.5 flex-shrink-0"
              >
              </div>
              <span>Frecuencia de 433 MHz para alta penetración.</span>
            </li>
            <li class="flex items-start gap-2">
              <div
                class="w-1.5 h-1.5 rounded-full bg-rojo-light mt-1.5 flex-shrink-0"
              >
              </div>
              <span>Bajo consumo energético.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initTelemetryGallery() {
    const imgGps = document.getElementById("img-gps");
    const imgLora = document.getElementById("img-lora");
    const glow = document.getElementById("telemetry-glow");
    const gallery = document.getElementById("telemetry-gallery");

    if (!imgGps || !imgLora || !glow || !gallery) return;

    let activeSensor = "default";

    const setSensorActive = (sensor: string) => {
      if (activeSensor === sensor) return;
      activeSensor = sensor;

      if (sensor === "gps") {
        imgGps.className = "absolute cursor-pointer object-contain transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] z-20 top-1/2 -translate-y-1/2 h-[220px] md:h-[360px] w-auto drop-shadow-[0_0_20px_rgba(1,95,179,0.5)] opacity-100 scale-100 left-1/2 -translate-x-1/2";
        imgLora.className = "absolute cursor-pointer object-contain transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] z-10 top-1/2 -translate-y-1/2 h-[100px] md:h-[180px] w-auto drop-shadow-lg opacity-60 scale-90 left-[85%] md:left-[92%] -translate-x-1/2";
        glow.className = "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 sm:w-64 sm:h-64 bg-azul-light/30 rounded-full blur-[80px] pointer-events-none -z-10 transition-colors duration-700";
      } else if (sensor === "lora") {
        imgLora.className = "absolute cursor-pointer object-contain transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] z-20 top-1/2 -translate-y-1/2 h-[220px] md:h-[360px] w-auto drop-shadow-[0_0_20px_rgba(200,10,25,0.5)] opacity-100 scale-100 left-1/2 -translate-x-1/2";
        imgGps.className = "absolute cursor-pointer object-contain transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] z-10 top-1/2 -translate-y-1/2 h-[100px] md:h-[180px] w-auto drop-shadow-lg opacity-60 scale-90 left-[15%] md:left-[8%] -translate-x-1/2";
        glow.className = "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 sm:w-64 sm:h-64 bg-rojo-light/30 rounded-full blur-[80px] pointer-events-none -z-10 transition-colors duration-700";
      } else {
        // default
        imgGps.className = "absolute cursor-pointer object-contain transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] z-10 top-1/2 -translate-y-1/2 h-[150px] md:h-[260px] w-auto drop-shadow-lg opacity-100 scale-100 left-[30%] md:left-[15%] -translate-x-1/2";
        imgLora.className = "absolute cursor-pointer object-contain transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] z-10 top-1/2 -translate-y-1/2 h-[150px] md:h-[260px] w-auto drop-shadow-lg opacity-100 scale-100 left-[70%] md:left-[85%] -translate-x-1/2";
        glow.className = "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 sm:w-64 sm:h-64 bg-transparent rounded-full blur-[80px] pointer-events-none -z-10 transition-colors duration-700";
      }
    };

    imgGps.addEventListener("mouseenter", () => setSensorActive("gps"));
    imgLora.addEventListener("mouseenter", () => setSensorActive("lora"));
    imgGps.addEventListener("mouseleave", () => setSensorActive("default"));
    imgLora.addEventListener("mouseleave", () => setSensorActive("default"));
  }

  document.addEventListener("DOMContentLoaded", initTelemetryGallery);
  document.addEventListener("astro:page-load", initTelemetryGallery);
</script>
